---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getLocale, useTranslations, localePath, type UIKey } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links: { href: string; key: UIKey; match: string }[] = [
  { href: '/rules/', key: 'nav.rules', match: '/rules' },
  { href: '/translate/', key: 'nav.translate', match: '/translate' },
  { href: '/showcase/', key: 'nav.showcase', match: '/showcase' },
  { href: '/research/', key: 'nav.research', match: '/research' },
  { href: '/skills/', key: 'nav.skills', match: '/skills' },
  { href: '/about/', key: 'nav.about', match: '/about' },
];
// Active-state test is locale-aware: /es/rules should match the localized href.
const isActive = (match: string) => {
  const m = localePath(match, locale);
  return path === m || path.startsWith(m + '/');
};
---

<header class="site-header">
  <div class="shell bar">
    <a class="wordmark" href={localePath('/', locale)}>
      <span class="wordmark__name">World English</span>
      <span class="wordmark__say" aria-hidden="true">WERLD ING-glish</span>
    </a>

    <nav class="nav" aria-label={t('nav.primary')}>
      {links.map((l) => (
        <a href={localePath(l.href, locale)} class:list={['nav__link', { 'is-active': isActive(l.match) }]}>
          {t(l.key)}
        </a>
      ))}
    </nav>

    <div class="tools">
      <Search />
      <LangSwitcher />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: var(--border-w) solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
    padding-block: var(--space-2);
  }
  .wordmark {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    line-height: 1.1;
    margin-right: auto;
  }
  .wordmark__name {
    font-weight: 700;
    font-size: var(--text-base);
  }
  .wordmark__say {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .nav {
    display: flex;
    gap: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
  .nav__link {
    color: var(--text-muted);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .nav__link:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav__link.is-active {
    color: var(--accent);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  /* Below 40rem the wordmark + links + tools no longer fit on one row, so the
     nav drops to its own full-width row (scrollable if still tight). */
  @media (max-width: 40rem) {
    .bar {
      flex-wrap: wrap;
      row-gap: var(--space-2);
      column-gap: var(--space-2);
    }
    .tools {
      order: 2;
    }
    .nav {
      order: 3;
      flex-basis: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      border-top: var(--border-w) solid var(--border);
      padding-top: var(--space-2);
    }
  }
  @media (max-width: 34rem) {
    .wordmark__say {
      display: none;
    }
  }
</style>
