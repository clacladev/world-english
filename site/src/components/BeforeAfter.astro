---
// Side-by-side "Standard English -> World English" card. Pass the two texts as
// the `before`/`after` slots; wrap changed words in <mark> to highlight them.
interface Props {
  note?: string;
}
const { note } = Astro.props;
---

<figure class="ba">
  <div class="ba__col ba__col--before">
    <span class="ba__tag">Standard English</span>
    <p class="ba__text"><slot name="before" /></p>
  </div>
  <div class="ba__arrow" aria-hidden="true">→</div>
  <div class="ba__col ba__col--after">
    <span class="ba__tag ba__tag--after">World English</span>
    <p class="ba__text"><slot name="after" /></p>
  </div>
  {note && <figcaption class="ba__note">{note}</figcaption>}
</figure>

<style>
  .ba {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 0;
    margin: 0;
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .ba__col {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ba__col--after {
    background: var(--accent-soft);
  }
  .ba__tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
  }
  .ba__tag--after {
    color: var(--accent);
  }
  .ba__text {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.55;
  }
  .ba__arrow {
    display: grid;
    place-items: center;
    padding-inline: var(--space-2);
    color: var(--accent);
    font-size: 1.4rem;
    background: var(--surface);
    border-inline: var(--border-w) solid var(--border);
  }
  .ba__note {
    grid-column: 1 / -1;
    padding: var(--space-2) var(--space-5) var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    background: var(--surface);
    border-top: var(--border-w) solid var(--border);
  }
  /* changed words */
  :global(.ba__text mark) {
    background: transparent;
    color: var(--accent);
    font-weight: 700;
    box-shadow: inset 0 -0.4em 0 var(--accent-soft);
    padding: 0 0.05em;
  }
  .ba__col--after :global(.ba__text mark) {
    box-shadow: inset 0 -0.4em 0 color-mix(in srgb, var(--accent) 22%, transparent);
  }

  @media (max-width: 40rem) {
    .ba {
      grid-template-columns: 1fr;
    }
    .ba__arrow {
      transform: rotate(90deg);
      border-inline: none;
      border-block: var(--border-w) solid var(--border);
      padding-block: var(--space-1);
    }
  }
</style>
