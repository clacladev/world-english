---
import { getLocale, defaultLocale } from '../../i18n/ui';

const locale = getLocale(Astro.currentLocale);

// The example sentences (placeholders) are WoE/English specimens and stay
// verbatim in every language; only descriptive UI text is translated. Strings
// the client script sets at runtime are passed to it via the data-i18n attribute
// below so the single bundled script serves every locale.
const DICT = {
  en: {
    eyebrow: 'Try it',
    h1: 'Translator',
    lede:
      'Type standard English and see it in World English, or paste World English and convert it back. This runs the same deterministic translator that ships with the project — entirely in your browser.',
    dirLabel: 'Translation direction',
    standard: 'Standard',
    notesTitle: 'Notes',
    notesHint:
      'The translator only applies deterministic changes. These are forms it declined to guess — they need part of speech, syntax, or the core lexicon to resolve.',
    swapTitle: 'Swap direction and texts',
    // Runtime strings for the script.
    js: {
      labelStandard: 'Standard English',
      labelWoe: 'World English',
      phStandard: 'She has taken the children to see the mice.',
      phWoe: 'She taked the childs to see the mouses.',
      copy: 'Copy',
      copied: 'Copied',
      loading: 'Loading…',
      loadFail: 'Failed to load translator.',
      notesEmpty: 'No flags — every form was converted deterministically.',
    },
  },
  es: {
    eyebrow: 'Pruébalo',
    h1: 'Traductor',
    lede:
      'Escribe en inglés estándar y velo en World English, o pega World English y conviértelo de vuelta. Esto ejecuta el mismo traductor determinista que incluye el proyecto, enteramente en tu navegador.',
    dirLabel: 'Dirección de traducción',
    standard: 'Estándar',
    notesTitle: 'Notas',
    notesHint:
      'El traductor solo aplica cambios deterministas. Estas son formas que prefirió no adivinar: necesitan categoría gramatical, sintaxis o el léxico central para resolverse.',
    swapTitle: 'Intercambiar dirección y textos',
    js: {
      labelStandard: 'Inglés estándar',
      labelWoe: 'World English',
      phStandard: 'She has taken the children to see the mice.',
      phWoe: 'She taked the childs to see the mouses.',
      copy: 'Copiar',
      copied: 'Copiado',
      loading: 'Cargando…',
      loadFail: 'No se pudo cargar el traductor.',
      notesEmpty: 'Sin marcas: cada forma se convirtió de manera determinista.',
    },
  },
  zh: {
    eyebrow: '试一试',
    h1: '翻译器',
    lede:
      '输入标准英语，看它变成 World English；或粘贴 World English，把它转换回去。它运行的是项目自带的同一个确定性翻译器——完全在你的浏览器里进行。',
    dirLabel: '翻译方向',
    standard: '标准英语',
    notesTitle: '备注',
    notesHint:
      '翻译器只做确定性的改动。以下是它不愿臆测的形式——它们需要词性、句法或核心词汇才能确定。',
    swapTitle: '交换方向和文本',
    js: {
      labelStandard: '标准英语',
      labelWoe: 'World English',
      phStandard: 'She has taken the children to see the mice.',
      phWoe: 'She taked the childs to see the mouses.',
      copy: '复制',
      copied: '已复制',
      loading: '加载中…',
      loadFail: '翻译器加载失败。',
      notesEmpty: '没有标记——每个形式都已确定性地转换。',
    },
  },
};
const COPY = DICT[locale] ?? DICT.en;
---

<div class="shell page">
  <p class="eyebrow">{COPY.eyebrow}</p>
  <h1>{COPY.h1}</h1>
  <p class="lede">{COPY.lede}</p>

  <div class="tr" data-translate data-i18n={JSON.stringify(COPY.js)}>
    <div class="tr__dir" role="tablist" aria-label={COPY.dirLabel}>
      <button type="button" class="tr__dir-btn is-active" data-dir="forward" role="tab" aria-selected="true">
        {COPY.standard} <span aria-hidden="true">→</span> World English
      </button>
      <button type="button" class="tr__dir-btn" data-dir="reverse" role="tab" aria-selected="false">
        World English <span aria-hidden="true">→</span> {COPY.standard}
      </button>
    </div>

    <div class="tr__panels">
      <div class="tr__panel">
        <div class="tr__head">
          <label class="tr__label" for="tr-input" data-in-label>{COPY.js.labelStandard}</label>
          <span class="tr__head-spacer" aria-hidden="true"></span>
        </div>
        <textarea id="tr-input" class="tr__area" rows="8" spellcheck="false" placeholder={COPY.js.phStandard}></textarea>
      </div>

      <div class="tr__swap">
        <button type="button" class="tr__swap-btn" data-swap title={COPY.swapTitle} aria-label={COPY.swapTitle}>
          <span aria-hidden="true">⇄</span>
        </button>
      </div>

      <div class="tr__panel">
        <div class="tr__head">
          <label class="tr__label" for="tr-output" data-out-label>{COPY.js.labelWoe}</label>
          <button type="button" class="tr__copy" data-copy hidden>{COPY.js.copy}</button>
        </div>
        <textarea id="tr-output" class="tr__area" rows="8" readonly spellcheck="false" placeholder={COPY.js.phWoe}></textarea>
      </div>
    </div>

    <div class="tr__notes" data-notes>
      <p class="tr__notes-title">{COPY.notesTitle}</p>
      <ul class="tr__notes-list" data-notes-list></ul>
      <p class="tr__notes-empty" data-notes-empty hidden>{COPY.js.notesEmpty}</p>
      <p class="tr__notes-hint">{COPY.notesHint}</p>
    </div>

    <p class="tr__status" data-status></p>
  </div>
</div>

<script>
  const root = document.querySelector('[data-translate]');
  if (root) {
    // UI strings for this locale, rendered into the element by Astro.
    const T = JSON.parse(root.dataset.i18n);
    const input = root.querySelector('#tr-input');
    const output = root.querySelector('#tr-output');
    const notes = root.querySelector('[data-notes]');
    const notesList = root.querySelector('[data-notes-list]');
    const notesEmpty = root.querySelector('[data-notes-empty]');
    const status = root.querySelector('[data-status]');
    const copyBtn = root.querySelector('[data-copy]');
    const dirBtns = root.querySelectorAll('[data-dir]');
    const swapBtn = root.querySelector('[data-swap]');
    const inLabel = root.querySelector('[data-in-label]');
    const outLabel = root.querySelector('[data-out-label]');

    let direction = 'forward';
    let run = null;
    let timer = null;

    const load = async () => {
      if (run) return run;
      status.textContent = T.loading;
      try {
        const [fwd, rev] = await Promise.all([
          import('../../../../tools/src/translate.ts'),
          import('../../../../tools/src/reverse.ts'),
        ]);
        run = { forward: fwd.translate, reverse: rev.reverseTranslate };
      } catch (e) {
        status.textContent = T.loadFail;
        console.error(e);
        throw e;
      }
      status.textContent = '';
      return run;
    };

    const doTranslate = async () => {
      const text = input.value;
      if (!text.trim()) {
        output.value = '';
        notesList.innerHTML = '';
        notesEmpty.hidden = true;
        copyBtn.hidden = true;
        return;
      }
      const t = await load();
      if (!t) return;
      const res = direction === 'forward'
        ? t.forward(text, { strict: true })
        : t.reverse(text);
      output.value = res.text;
      copyBtn.hidden = !res.text;

      const flags = res.flags ?? [];
      notesList.innerHTML = '';
      if (flags.length) {
        for (const f of flags) {
          const li = document.createElement('li');
          const target = f.restored ?? f.expected;
          li.textContent = `"${f.found}" → "${target}"  ·  ${f.rule} · ${f.note ?? f.class}`;
          notesList.appendChild(li);
        }
        notesEmpty.hidden = true;
      } else {
        notesEmpty.hidden = false;
      }
    };

    const schedule = () => {
      clearTimeout(timer);
      timer = setTimeout(doTranslate, 250);
    };

    const setDirection = (dir) => {
      if (dir === direction) return;
      direction = dir;
      dirBtns.forEach((b) => {
        const active = b.dataset.dir === dir;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      const isFwd = dir === 'forward';
      inLabel.textContent = isFwd ? T.labelStandard : T.labelWoe;
      outLabel.textContent = isFwd ? T.labelWoe : T.labelStandard;
      input.placeholder = isFwd ? T.phStandard : T.phWoe;
      output.placeholder = isFwd ? T.phWoe : T.phStandard;
      schedule();
    };

    input.addEventListener('input', schedule);
    input.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        doTranslate();
      }
    });

    dirBtns.forEach((b) =>
      b.addEventListener('click', () => setDirection(b.dataset.dir)),
    );

    swapBtn.addEventListener('click', () => {
      const swapped = output.value;
      setDirection(direction === 'forward' ? 'reverse' : 'forward');
      input.value = swapped;
      schedule();
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(output.value);
        copyBtn.textContent = T.copied;
        setTimeout(() => (copyBtn.textContent = T.copy), 1500);
      } catch {
        output.select();
        document.execCommand('copy');
      }
    });

    load();
  }
</script>

<style>
  .page {
    padding-block: var(--space-8) var(--space-10);
    max-width: var(--content);
    margin-inline: auto;
  }
  .page h1 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-4);
  }

  .tr {
    margin-top: var(--space-6);
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .tr__dir {
    display: inline-flex;
    gap: var(--space-1);
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    padding: 3px;
    margin-bottom: var(--space-4);
  }
  .tr__dir-btn {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .tr__dir-btn.is-active {
    background: var(--surface);
    color: var(--accent);
    box-shadow: var(--shadow-sm);
  }
  .tr__dir-btn:hover:not(.is-active) {
    color: var(--text);
  }

  .tr__panels {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: var(--space-3);
  }
  .tr__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .tr__label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
  }
  .tr__area {
    width: 100%;
    resize: vertical;
    min-height: 10rem;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: var(--leading);
    color: var(--text);
    background: var(--bg);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    box-sizing: border-box;
  }
  .tr__area:focus {
    outline: none;
    border-color: var(--focus);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 30%, transparent);
  }
  .tr__area[readonly] {
    background: var(--accent-soft);
    color: var(--text);
  }

  .tr__swap {
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--space-2);
  }
  .tr__swap-btn {
    appearance: none;
    border: var(--border-w) solid var(--border);
    background: var(--surface);
    color: var(--accent);
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.1rem;
    display: grid;
    place-items: center;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .tr__swap-btn:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .tr__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 1.9rem;
  }
  .tr__head-spacer {
    /* Mirrors the copy button's box so both panel headers have identical
       height and the textareas stay vertically aligned. */
    display: inline-block;
    width: 3.5rem;
    height: 1.6rem;
  }
  .tr__copy {
    appearance: none;
    border: var(--border-w) solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .tr__copy:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .tr__notes {
    margin-top: var(--space-4);
    border-top: var(--border-w) solid var(--border);
    padding-top: var(--space-3);
  }
  .tr__notes-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }
  .tr__notes-list {
    margin: 0 0 var(--space-3);
    padding-left: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
  }
  .tr__notes-hint {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    opacity: 0.85;
  }
  .tr__notes-empty {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
    opacity: 0.85;
  }

  .tr__status {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: var(--space-3) 0 0;
    min-height: 1.2em;
  }

  @media (max-width: 44rem) {
    .tr__panels {
      grid-template-columns: 1fr;
    }
    .tr__swap {
      justify-content: center;
      padding: 0;
    }
  }
</style>
