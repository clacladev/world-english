---
import BeforeAfter from '../BeforeAfter.astro';
import RuleCard from '../RuleCard.astro';
import { getLocale, localePath, defaultLocale } from '../../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const lp = (path: string) => localePath(path, locale);

// Page copy, per locale. WoE example forms (goed, taked, childs…), brand tokens,
// and the pronunciation card stay verbatim in every language — only descriptive
// prose is translated. English is the source of truth; add a locale by adding a
// column below (a missing locale falls back to English).
const DICT = {
  en: {
    eyebrow: 'World English · WoE',
    heroTitle: 'A simpler, more regular English.',
    heroLede:
      'English became the world’s shared language by accident of history — and it is one of the harder languages to learn well. <strong>World English</strong> is a careful revision that keeps what works and regularizes what doesn’t, so people anywhere can learn it with far less effort.',
    sayCaption: 'How a word is written should tell you how it is said.',
    statLabels: ['irregular verbs', 'forms of “be”', 'articles', 'irregular plurals'],
    ctaRules: 'Read the rules',
    ctaWhy: 'Why it exists',
    ideaTitle: 'The idea in ten seconds',
    ideaLede:
      'Take ordinary English, then delete the exceptions. Every change is transparent — you can still read it at a glance.',
    baNotes: [
      'Regular verbs (M1) and regular plurals (M4); the perfect collapses to the simple past (G1).',
      'One verb “be” for every person (M2); no “a/an” — indefinite things take no article (G2).',
      'Questions use a trailing “?” and rising pitch — no do-support, no word-order flip (G6).',
    ],
    showcaseEyebrow: 'See it carry real weight',
    showcaseCite: 'The Gettysburg Address, in World English',
    showcaseBody:
      'The best test of the reform is a text you already know by heart. We rendered the Universal Declaration of Human Rights and Lincoln\'s Gettysburg Address in World English by the book — every line applying the published rules, with not one abolished form left in. See what changes, and how much doesn\'t.',
    showcaseCta: 'Read them in World English →',
    goalsTitle: 'What it aims to be',
    goalsLede: 'Four goals, in the project’s own words.',
    goals: [
      ['Regular', 'Rules apply consistently, with as few exceptions as possible.'],
      ['Predictable', 'Know the rule and you can produce and read new forms — nobody has to teach you each one.'],
      ['Easier', 'Less to memorize, fewer traps, a gentler learning curve.'],
      ['Readable', 'To someone who already knows English, it still looks and reads like English. An evolution, not a cipher.'],
    ],
    prioTitle: 'What comes first',
    prioLede:
      'Language exists for communication, so World English orders its priorities plainly:',
    prioChain: ['ease', 'clarity', 'entertainment'],
    prioTail:
      'Where they conflict, the earlier one wins — which is why it trades away idiom and flourish. One constraint bounds all three: it must stay <strong>legible as English</strong>. An evolution, not a cipher.',
    rulesTitle: 'The main rules at a glance',
    rulesLede: 'A few of the load-bearing changes. Each links into the full specification.',
    ruleCards: [
      ['M1', 'All verbs are regular'],
      ['M3', 'No third-person “-s”'],
      ['M4', 'All plurals are regular'],
      ['G2', 'One article'],
      ['G1', 'A leaner tense system'],
      ['G6', 'Simple questions'],
      ['O1', 'One spelling'],
      ['P1', 'Spelling predicts sound'],
    ],
    rulesMore: 'See all the rules →',
    teaserEyebrow: 'Grounded in evidence',
    teaserTitle: 'The reasoning behind it',
    teaserCtaResearch: 'Read the research →',
    teaserCtaAbout: 'About the project →',
  },
  es: {
    eyebrow: 'World English · WoE',
    heroTitle: 'Un inglés más simple y más regular.',
    heroLede:
      'El inglés se convirtió en la lengua común del mundo por accidente de la historia, y es uno de los idiomas más difíciles de aprender bien. <strong>World English</strong> es una revisión cuidadosa que conserva lo que funciona y regulariza lo que no, para que cualquier persona pueda aprenderlo con mucho menos esfuerzo.',
    sayCaption: 'Cómo se escribe una palabra debería decirte cómo se pronuncia.',
    statLabels: ['verbos irregulares', 'formas de «be»', 'artículos', 'plurales irregulares'],
    ctaRules: 'Lee las reglas',
    ctaWhy: 'Por qué existe',
    ideaTitle: 'La idea en diez segundos',
    ideaLede:
      'Toma el inglés corriente y elimina las excepciones. Cada cambio es transparente: aún puedes leerlo de un vistazo.',
    baNotes: [
      'Verbos regulares (M1) y plurales regulares (M4); el perfecto se reduce al pasado simple (G1).',
      'Un solo verbo «be» para toda persona (M2); sin «a/an»: lo indefinido no lleva artículo (G2).',
      'Las preguntas usan un «?» final y entonación ascendente: sin do-support ni cambio de orden (G6).',
    ],
    showcaseEyebrow: 'Míralo sostener peso de verdad',
    showcaseCite: 'El Discurso de Gettysburg, en World English',
    showcaseBody:
      'La mejor prueba de la reforma es un texto que ya te sabes de memoria. Tradujimos la Declaración Universal de Derechos Humanos y el Discurso de Gettysburg de Lincoln a World English al pie de la letra: cada línea aplica las reglas publicadas, sin dejar ni una forma abolida. Mira qué cambia y cuánto no cambia.',
    showcaseCta: 'Léelos en World English →',
    goalsTitle: 'Lo que aspira a ser',
    goalsLede: 'Cuatro metas, en palabras del propio proyecto.',
    goals: [
      ['Regular', 'Las reglas se aplican de forma consistente, con las menos excepciones posibles.'],
      ['Predecible', 'Conoce la regla y podrás producir y leer formas nuevas: nadie tiene que enseñarte cada una.'],
      ['Más fácil', 'Menos que memorizar, menos trampas, una curva de aprendizaje más suave.'],
      ['Legible', 'Para quien ya sabe inglés, sigue pareciendo y leyéndose como inglés. Una evolución, no un cifrado.'],
    ],
    prioTitle: 'Qué va primero',
    prioLede:
      'El lenguaje existe para comunicar, así que World English ordena sus prioridades con claridad:',
    prioChain: ['facilidad', 'claridad', 'entretenimiento'],
    prioTail:
      'Cuando entran en conflicto, gana la anterior, y por eso renuncia al modismo y al adorno. Una sola restricción abarca las tres: debe seguir siendo <strong>legible como inglés</strong>. Una evolución, no un cifrado.',
    rulesTitle: 'Las reglas principales de un vistazo',
    rulesLede: 'Algunos de los cambios de fondo. Cada uno enlaza con la especificación completa.',
    ruleCards: [
      ['M1', 'Todos los verbos son regulares'],
      ['M3', 'Sin «-s» de tercera persona'],
      ['M4', 'Todos los plurales son regulares'],
      ['G2', 'Un solo artículo'],
      ['G1', 'Un sistema de tiempos más simple'],
      ['G6', 'Preguntas simples'],
      ['O1', 'Una sola ortografía'],
      ['P1', 'La escritura predice el sonido'],
    ],
    rulesMore: 'Ver todas las reglas →',
    teaserEyebrow: 'Con base en la evidencia',
    teaserTitle: 'El razonamiento detrás',
    teaserCtaResearch: 'Lee la investigación →',
    teaserCtaAbout: 'Sobre el proyecto →',
  },
  zh: {
    eyebrow: 'World English · WoE',
    heroTitle: '更简单、更规则的英语。',
    heroLede:
      '英语因历史的偶然成为世界通用语言，也是最难学好的语言之一。<strong>World English</strong> 是一次审慎的修订，保留行之有效的部分，把不规则的部分规整化，让世界各地的人都能用更少的力气学会它。',
    sayCaption: '一个词怎么写，就该告诉你它怎么读。',
    statLabels: ['不规则动词', '“be” 的形式', '冠词', '不规则复数'],
    ctaRules: '阅读规则',
    ctaWhy: '为什么存在',
    ideaTitle: '十秒钟看懂',
    ideaLede:
      '拿来普通的英语，删掉例外。每一处改动都清清楚楚——你依然能一眼读懂。',
    baNotes: [
      '规则动词（M1）与规则复数（M4）；完成体并入一般过去时（G1）。',
      '每个人称都用同一个动词 “be”（M2）；没有 “a/an”——不定指的事物不带冠词（G2）。',
      '疑问句用句末的 “?” 和上扬的语调——不用 do 助动词，也不调换语序（G6）。',
    ],
    showcaseEyebrow: '看它承载真正的分量',
    showcaseCite: '葛底斯堡演说，World English 版',
    showcaseBody:
      '检验一场改革，最好的方式是一段你早已烂熟于心的文字。我们严格照章把《世界人权宣言》和林肯的葛底斯堡演说译成了 World English——每一行都套用已发布的规则，不留一处被废弃的形式。看看什么变了，又有多少没变。',
    showcaseCta: '用 World English 读一读 →',
    goalsTitle: '它想成为什么',
    goalsLede: '四个目标，用项目自己的话说。',
    goals: [
      ['规则', '规则始终如一地适用，例外尽可能地少。'],
      ['可预测', '掌握规则，你就能造出并读懂新的形式——不必别人一个个教你。'],
      ['更容易', '要记的更少，陷阱更少，学习曲线更平缓。'],
      ['易读', '对已经懂英语的人来说，它看上去、读起来仍然像英语。是演进，不是密码。'],
    ],
    prioTitle: '什么优先',
    prioLede:
      '语言是为交流而存在的，所以 World English 明确地排定优先次序：',
    prioChain: ['易学', '清晰', '趣味'],
    prioTail:
      '当它们冲突时，靠前的胜出——这也是它舍弃习语和文采的原因。一条约束贯穿三者：它必须<strong>作为英语可读</strong>。是演进，不是密码。',
    rulesTitle: '主要规则一览',
    rulesLede: '几处起支撑作用的改动。每一处都链接到完整的规范。',
    ruleCards: [
      ['M1', '所有动词都规则'],
      ['M3', '没有第三人称 “-s”'],
      ['M4', '所有复数都规则'],
      ['G2', '只有一个冠词'],
      ['G1', '更精简的时态系统'],
      ['G6', '简单的疑问句'],
      ['O1', '统一的拼写'],
      ['P1', '拼写预示读音'],
    ],
    rulesMore: '查看全部规则 →',
    teaserEyebrow: '以证据为基础',
    teaserTitle: '背后的推理',
    teaserCtaResearch: '阅读研究 →',
    teaserCtaAbout: '关于本项目 →',
  },
};
const COPY = DICT[locale] ?? DICT.en;

// Static data whose WoE example forms never translate; only labels come from COPY.
const stats = [
  { before: '≈200', after: '0', href: '/rules/morphology/#rule-m1--all-verbs-are-regular' },
  { before: '8', after: '3', href: '/rules/morphology/#rule-m2--one-verb-of-be-regularized' },
  { before: '3', after: '1', href: '/rules/grammar/#rule-g2--one-article-rule' },
  { before: 'dozens', after: '0', href: '/rules/morphology/#rule-m4--all-plurals-are-regular' },
].map((s, i) => ({ ...s, label: COPY.statLabels[i] }));

const ruleMeta = [
  { href: '/rules/morphology/#rule-m1--all-verbs-are-regular' },
  { href: '/rules/morphology/#rule-m3--no-third-person--s' },
  { href: '/rules/morphology/#rule-m4--all-plurals-are-regular' },
  { href: '/rules/grammar/#rule-g2--one-article-rule' },
  { href: '/rules/grammar/#rule-g1--a-leaner-tenseaspect-system' },
  { href: '/rules/grammar/#rule-g6--regular-questions-and-negation-no-do-support' },
  { href: '/rules/orthography/#rule-o1--one-dialect-one-spelling' },
  { href: '/rules/pronunciation/' },
];
---

<!-- Hero -->
<section class="hero">
  <div class="shell">
    <div class="hero__inner col">
    <p class="eyebrow">{COPY.eyebrow}</p>
    <h1 class="hero__title">{COPY.heroTitle}</h1>
    <p class="hero__lede" set:html={COPY.heroLede} />

    <div class="say-card">
      <div class="say-card__row">
        <span class="say-card__name">World English</span>
        <span class="say-card__arrow" aria-hidden="true">→</span>
        <span class="say-card__respell">WERLD ING-glish</span>
        <span class="say-card__ipa" lang="en-fonipa">/wɝld ˈɪŋɡlɪʃ/</span>
      </div>
      <p class="say-card__caption">{COPY.sayCaption}</p>
    </div>

    <ul class="hero-stats">
      {
        stats.map((s) => (
          <li class="hero-stat">
            <a href={lp(s.href)}>
              <span class="hero-stat__nums" aria-hidden="true">
                <s class="hero-stat__before">{s.before}</s>
                <span class="hero-stat__arrow" aria-hidden="true">→</span>
                <b class="hero-stat__after">{s.after}</b>
              </span>
              <span class="hero-stat__label">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hero__cta">
      <a class="btn btn--primary" href={lp('/rules/')}>{COPY.ctaRules}</a>
      <a class="btn btn--ghost" href={lp('/research/')}>{COPY.ctaWhy}</a>
    </div>
    </div>
  </div>
</section>

<!-- The idea in 10 seconds -->
<section class="section">
  <div class="shell">
    <div class="col">
    <header class="sec-head">
      <h2>{COPY.ideaTitle}</h2>
      <p class="lede">{COPY.ideaLede}</p>
    </header>

    <div class="ba-stack">
      <BeforeAfter note={COPY.baNotes[0]}>
        <Fragment slot="before">She has <mark>taken</mark> the <mark>children</mark> to see the <mark>mice</mark>.</Fragment>
        <Fragment slot="after">She <mark>taked</mark> the <mark>childs</mark> to see the <mark>mouses</mark>.</Fragment>
      </BeforeAfter>

      <BeforeAfter note={COPY.baNotes[1]}>
        <Fragment slot="before">She <mark>is</mark> <mark>a</mark> good doctor.</Fragment>
        <Fragment slot="after">She <mark>be</mark> good doctor.</Fragment>
      </BeforeAfter>

      <BeforeAfter note={COPY.baNotes[2]}>
        <Fragment slot="before"><mark>Have you seen</mark> my keys?</Fragment>
        <Fragment slot="after"><mark>You seed</mark> my keys?</Fragment>
      </BeforeAfter>
    </div>
    </div>
  </div>
</section>

<!-- Showcase -->
<section class="section">
  <div class="shell">
    <div class="col">
    <div class="showcase">
      <p class="showcase__eyebrow">{COPY.showcaseEyebrow}</p>
      <blockquote class="showcase__quote">
        “…that these dead shall not die in vain — that this nation, under God, shall have
        <mark>new</mark> birth of freedom — and that government of the people, by the people,
        for the people, shall not perish from the earth.”
      </blockquote>
      <p class="showcase__cite">{COPY.showcaseCite}</p>
      <p class="showcase__body">{COPY.showcaseBody}</p>
      <p class="showcase__cta">
        <a class="btn btn--primary" href={lp('/showcase/')}>{COPY.showcaseCta}</a>
      </p>
    </div>
    </div>
  </div>
</section>

<!-- Goals -->
<section class="section section--tint">
  <div class="shell">
    <header class="sec-head col">
      <h2>{COPY.goalsTitle}</h2>
      <p class="lede">{COPY.goalsLede}</p>
    </header>
    <ul class="goals col">
      {
        COPY.goals.map(([title, body]) => (
          <li class="goal">
            <h3 class="goal__title">{title}</h3>
            <p class="goal__body">{body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Priorities -->
<section class="section">
  <div class="shell">
    <div class="col">
    <header class="sec-head">
      <h2>{COPY.prioTitle}</h2>
    </header>
    <p class="prio">
      {COPY.prioLede}
      <span class="prio__chain"
        ><b>{COPY.prioChain[0]}</b> <span aria-hidden="true">›</span> <b>{COPY.prioChain[1]}</b>
        <span aria-hidden="true">›</span> <b>{COPY.prioChain[2]}</b></span
      >. <Fragment set:html={COPY.prioTail} />
    </p>
    </div>
  </div>
</section>

<!-- Main rules at a glance -->
<section class="section section--tint">
  <div class="shell">
    <header class="sec-head col">
      <h2>{COPY.rulesTitle}</h2>
      <p class="lede">{COPY.rulesLede}</p>
    </header>
    <div class="rule-grid col">
      <RuleCard id="M1" title={COPY.ruleCards[0][1]} href={lp(ruleMeta[0].href)}>
        <b>go → goed</b>, <b>take → taked</b>. About 200 irregular verbs disappear; one <code>-ed</code> rule replaces the list.
      </RuleCard>
      <RuleCard id="M3" title={COPY.ruleCards[1][1]} href={lp(ruleMeta[1].href)}>
        <b>he go</b>, <b>she try</b>. One present-tense form for every person.
      </RuleCard>
      <RuleCard id="M4" title={COPY.ruleCards[2][1]} href={lp(ruleMeta[2].href)}>
        <b>childs</b>, <b>foots</b>, <b>mouses</b>. Add <code>-s</code>, always — no irregular or borrowed plurals.
      </RuleCard>
      <RuleCard id="G2" title={COPY.ruleCards[3][1]} href={lp(ruleMeta[3].href)}>
        Just <b>the</b>, for known things. Indefinite things take no article. No <em>a/an</em>.
      </RuleCard>
      <RuleCard id="G1" title={COPY.ruleCards[4][1]} href={lp(ruleMeta[4].href)}>
        Three tenses, no perfect. Still true? Use present. Finished? Use past. The question has one answer.
      </RuleCard>
      <RuleCard id="G6" title={COPY.ruleCards[5][1]} href={lp(ruleMeta[5].href)}>
        A trailing <b>?</b> and rising pitch. No <em>do</em>-support, no inversion, invariant tag <b>right?</b>
      </RuleCard>
      <RuleCard id="O1" title={COPY.ruleCards[6][1]} href={lp(ruleMeta[6].href)}>
        <b>color</b>, <b>center</b>, <b>realize</b>. One dialect, the shorter and more phonetic form.
      </RuleCard>
      <RuleCard id="P1" title={COPY.ruleCards[7][1]} href={lp(ruleMeta[7].href)}>
        A simple respelling key — <b>ING-glish</b> — so you can say any word from how it is written.
      </RuleCard>
    </div>
    <p class="rule-grid__more col">
      <a class="btn btn--ghost" href={lp('/rules/')}>{COPY.rulesMore}</a>
    </p>
  </div>
</section>

<!-- Research teaser -->
<section class="section">
  <div class="shell">
    <div class="teaser col">
    <header class="sec-head">
      <p class="eyebrow">{COPY.teaserEyebrow}</p>
      <h2>{COPY.teaserTitle}</h2>
    </header>
    <p>
      {
        locale === 'zh' ? (
          <Fragment>
            World English 是一项设计与研究工作，而非一场运动。它从一份有研究支撑的调查出发，考察
            <a href={lp('/research/pain-points/')}>究竟是什么让英语难学</a>，依据一份
            <a href={lp('/research/irregularities/')}>语言强迫你记忆之物的清单</a>展开，并把每一个选择与
            <a href={lp('/research/prior-art/')}>一个世纪以来的历次改革</a>相对照——诚实地指出证据在哪里
            支持某条规则，又在哪里提出反对。
          </Fragment>
        ) : locale === 'es' ? (
          <Fragment>
            World English es un esfuerzo de diseño e investigación, no una campaña. Parte de un
            estudio con base científica sobre <a href={lp('/research/pain-points/')}>qué hace que el inglés
            sea difícil de aprender</a>, trabaja a partir de un <a href={lp('/research/irregularities/')}>catálogo de
            lo que el idioma te obliga a memorizar</a> y contrasta cada decisión con
            <a href={lp('/research/prior-art/')}>un siglo de reformas anteriores</a>, señalando con honestidad
            dónde la evidencia respalda una regla y dónde la contradice.
          </Fragment>
        ) : (
          <Fragment>
            World English is a design and research effort, not a campaign. It starts from a
            research-backed survey of <a href={lp('/research/pain-points/')}>what actually makes English
            hard to learn</a>, works from a <a href={lp('/research/irregularities/')}>catalogue of what the
            language forces you to memorize</a>, and measures every choice against
            <a href={lp('/research/prior-art/')}>a century of earlier reforms</a> — noting honestly where
            the evidence backs a rule and where it pushes back.
          </Fragment>
        )
      }
    </p>
    <p class="research-cta">
      <a class="btn btn--ghost" href={lp('/research/')}>{COPY.teaserCtaResearch}</a>
      <a class="btn btn--ghost" href={lp('/about/')}>{COPY.teaserCtaAbout}</a>
    </p>
    </div>
  </div>
</section>

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-12) var(--space-10);
    background:
      radial-gradient(60rem 30rem at 50% -10%, var(--accent-soft), transparent 70%);
  }
  /* One shared, centered content column. Everything — hero, section heads,
     prose, and card grids — spans exactly this width, left-aligned inside it,
     so the whole page has a single axis and a single pair of edges. */
  .col {
    max-width: var(--content);
    margin-inline: auto;
  }

  .hero__title {
    font-size: var(--text-3xl);
    margin: var(--space-2) 0 var(--space-4);
  }
  .hero__lede {
    font-size: var(--text-md);
    color: var(--text-muted);
  }
  .say-card {
    margin: var(--space-8) 0 0;
    max-width: 34rem;
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: var(--space-4) var(--space-5);
  }
  .say-card__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }
  .say-card__name {
    font-weight: 700;
    font-size: var(--text-base);
  }
  .say-card__arrow {
    color: var(--accent);
  }
  .say-card__respell,
  .say-card__ipa {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .say-card__respell {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .say-card__ipa {
    color: var(--text-muted);
  }
  .say-card__caption {
    margin: var(--space-3) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  /* What disappears — the quantified hook under the pronunciation card */
  .hero-stats {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
