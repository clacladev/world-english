---
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import RuleCard from '../components/RuleCard.astro';

const goals = [
  { title: 'Regular', body: 'Rules apply consistently, with as few exceptions as possible.' },
  { title: 'Predictable', body: 'Know the rule and you can produce and read new forms — nobody has to teach you each one.' },
  { title: 'Easier', body: 'Less to memorize, fewer traps, a gentler learning curve.' },
  { title: 'Readable', body: 'To someone who already knows English, it still looks and reads like English. An evolution, not a cipher.' },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="shell hero__inner">
      <p class="eyebrow">World English · WoE</p>
      <h1 class="hero__title">A simpler, more regular English.</h1>
      <p class="hero__lede">
        English became the world’s shared language by accident of history — and it is one of
        the harder languages to learn well. <strong>World English</strong> is a careful revision
        that keeps what works and regularizes what doesn’t, so people anywhere can learn it with
        far less effort.
      </p>

      <div class="say-card">
        <div class="say-card__row">
          <span class="say-card__name">World English</span>
          <span class="say-card__arrow" aria-hidden="true">→</span>
          <span class="say-card__respell">WERLD ING-glish</span>
          <span class="say-card__ipa" lang="en-fonipa">/wɝld ˈɪŋɡlɪʃ/</span>
        </div>
        <p class="say-card__caption">How a word is written should tell you how it is said.</p>
      </div>

      <div class="hero__cta">
        <a class="btn btn--primary" href="/rules/">Read the rules</a>
        <a class="btn btn--ghost" href="/research/">Why it exists</a>
      </div>
    </div>
  </section>

  <!-- The idea in 10 seconds -->
  <section class="section">
    <div class="shell">
      <header class="sec-head">
        <h2>The idea in ten seconds</h2>
        <p class="lede">
          Take ordinary English, then delete the exceptions. Every change is transparent — you
          can still read it at a glance.
        </p>
      </header>

      <div class="ba-stack">
        <BeforeAfter note="Regular verbs (M1) and regular plurals (M4); the perfect collapses to the simple past (G1).">
          <Fragment slot="before">She has <mark>taken</mark> the <mark>children</mark> to see the <mark>mice</mark>.</Fragment>
          <Fragment slot="after">She <mark>taked</mark> the <mark>childs</mark> to see the <mark>mouses</mark>.</Fragment>
        </BeforeAfter>

        <BeforeAfter note="One verb “be” for every person (M2); no “a/an” — indefinite things take no article (G2).">
          <Fragment slot="before">She <mark>is</mark> <mark>a</mark> good doctor.</Fragment>
          <Fragment slot="after">She <mark>be</mark> good doctor.</Fragment>
        </BeforeAfter>

        <BeforeAfter note="Questions use a leading “?” and rising pitch — no do-support, no word-order flip (G6).">
          <Fragment slot="before"><mark>Have you seen</mark> <mark>my</mark> keys?</Fragment>
          <Fragment slot="after"><mark>?You seed</mark> <mark>mes</mark> keys?</Fragment>
        </BeforeAfter>
      </div>
    </div>
  </section>

  <!-- Goals -->
  <section class="section section--tint">
    <div class="shell">
      <header class="sec-head">
        <h2>What it aims to be</h2>
        <p class="lede">Four goals, in the project’s own words.</p>
      </header>
      <ul class="goals">
        {
          goals.map((g) => (
            <li class="goal">
              <h3 class="goal__title">{g.title}</h3>
              <p class="goal__body">{g.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Priorities -->
  <section class="section">
    <div class="shell">
      <header class="sec-head">
        <h2>What comes first</h2>
      </header>
      <p class="prio">
        Language exists for communication, so World English orders its priorities plainly:
        <span class="prio__chain">
          <b>ease</b> <span aria-hidden="true">›</span> <b>clarity</b>
          <span aria-hidden="true">›</span> <b>entertainment</b>
        </span>.
        Where they conflict, the earlier one wins — which is why it trades away idiom and
        flourish. One constraint bounds all three: it must stay
        <strong>legible as English</strong>. An evolution, not a cipher.
      </p>
    </div>
  </section>

  <!-- Main rules at a glance -->
  <section class="section section--tint">
    <div class="shell">
      <header class="sec-head">
        <h2>The main rules at a glance</h2>
        <p class="lede">
          A few of the load-bearing changes. Each links into the full specification.
        </p>
      </header>
      <div class="rule-grid">
        <RuleCard id="M1" title="All verbs are regular" href="/rules/morphology/#rule-m1--all-verbs-are-regular">
          <b>go → goed</b>, <b>take → taked</b>. About 200 irregular verbs disappear; one <code>-ed</code> rule replaces the list.
        </RuleCard>
        <RuleCard id="M3" title="No third-person “-s”" href="/rules/morphology/#rule-m3--no-third-person--s">
          <b>he go</b>, <b>she try</b>. One present-tense form for every person.
        </RuleCard>
        <RuleCard id="M4" title="All plurals are regular" href="/rules/morphology/#rule-m4--all-plurals-are-regular">
          <b>childs</b>, <b>foots</b>, <b>mouses</b>. Add <code>-s</code>, always — no irregular or borrowed plurals.
        </RuleCard>
        <RuleCard id="G2" title="One article" href="/rules/grammar/#rule-g2--one-article-rule">
          Just <b>the</b>, for known things. Indefinite things take no article. No <em>a/an</em>.
        </RuleCard>
        <RuleCard id="G1" title="A leaner tense system" href="/rules/grammar/#rule-g1--a-leaner-tenseaspect-system">
          Three tenses, no perfect. Still true? Use present. Finished? Use past. The question has one answer.
        </RuleCard>
        <RuleCard id="G6" title="Simple questions" href="/rules/grammar/#rule-g6--regular-questions-and-negation-no-do-support">
          A leading <b>?</b> and rising pitch. No <em>do</em>-support, no inversion, invariant tag <b>right?</b>
        </RuleCard>
        <RuleCard id="O1" title="One spelling" href="/rules/orthography/#rule-o1--one-dialect-one-spelling">
          <b>color</b>, <b>center</b>, <b>realize</b>. One dialect, the shorter and more phonetic form.
        </RuleCard>
        <RuleCard id="P1" title="Spelling predicts sound" href="/rules/pronunciation/">
          A simple respelling key — <b>ING-glish</b> — so you can say any word from how it is written.
        </RuleCard>
      </div>
      <p class="rule-grid__more">
        <a class="btn btn--ghost" href="/rules/">See all the rules →</a>
      </p>
    </div>
  </section>

  <!-- Research teaser -->
  <section class="section">
    <div class="shell teaser">
      <header class="sec-head">
        <p class="eyebrow">Grounded in evidence</p>
        <h2>The reasoning behind it</h2>
      </header>
      <p>
        World English is a design and research effort, not a campaign. It starts from a
        research-backed survey of <a href="/research/pain-points/">what actually makes English
        hard to learn</a>, works from a <a href="/research/irregularities/">catalogue of what the
        language forces you to memorize</a>, and measures every choice against
        <a href="/research/prior-art/">a century of earlier reforms</a> — noting honestly where
        the evidence backs a rule and where it pushes back.
      </p>
      <p class="research-cta">
        <a class="btn btn--ghost" href="/research/">Read the research →</a>
        <a class="btn btn--ghost" href="/about/">About the project →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-12) var(--space-10);
    background:
      radial-gradient(60rem 30rem at 50% -10%, var(--accent-soft), transparent 70%);
  }
  .hero__inner {
    max-width: 52rem;
    text-align: center;
  }
  .hero__title {
    font-size: var(--text-3xl);
    margin: var(--space-2) 0 var(--space-4);
  }
  .hero__lede {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 42rem;
    margin-inline: auto;
  }
  .say-card {
    margin: var(--space-8) auto 0;
    max-width: 34rem;
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: var(--space-4) var(--space-5);
  }
  .say-card__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
  }
  .say-card__name {
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .say-card__arrow {
    color: var(--accent);
  }
  .say-card__respell,
  .say-card__ipa {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .say-card__respell {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .say-card__ipa {
    color: var(--text-muted);
  }
  .say-card__caption {
    margin: var(--space-3) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .hero__cta {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  /* Section heads — left-aligned to the section's content edge, with a readable
     measure. Headings and their intro text share the same left edge as the cards
     below them. */
  .sec-head {
    max-width: 48rem;
    margin-bottom: var(--space-6);
  }
  .sec-head h2 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-2);
  }

  .ba-stack {
    display: grid;
    gap: var(--space-4);
    max-width: 52rem;
  }

  /* Goals */
  .goals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
  }
  .goal {
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .goal__title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
    color: var(--accent);
  }
  .goal__body {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* Priorities */
  .prio {
    max-width: 48rem;
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .prio__chain {
    white-space: nowrap;
  }
  .prio__chain b {
    color: var(--accent);
  }
  .prio__chain span {
    color: var(--text-muted);
    margin-inline: 0.15em;
  }

  /* Rule grid */
  .rule-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-4);
  }
  .rule-grid :global(code) {
    background: var(--surface-2);
    border-radius: 4px;
    padding: 0 0.3em;
  }
  .rule-grid__more {
    margin-top: var(--space-6);
  }

  /* Research teaser — keep the prose at a readable measure, left-aligned */
  .teaser > p {
    max-width: 48rem;
  }
  .research-cta {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }
</style>
