---
import Base from '../layouts/Base.astro';
---

<Base
  title="Translator"
  description="Translate text between Standard English and World English. The same deterministic translator that powers the tools, running in your browser."
>
  <div class="shell page">
    <p class="eyebrow">Try it</p>
    <h1>Translator</h1>
    <p class="lede">
      Type standard English and see it in World English, or paste World English
      and convert it back. This runs the same deterministic translator that
      ships with the project — entirely in your browser.
    </p>

    <div class="tr" data-translate>
      <div class="tr__dir" role="tablist" aria-label="Translation direction">
        <button type="button" class="tr__dir-btn is-active" data-dir="forward" role="tab" aria-selected="true">
          Standard <span aria-hidden="true">→</span> World English
        </button>
        <button type="button" class="tr__dir-btn" data-dir="reverse" role="tab" aria-selected="false">
          World English <span aria-hidden="true">→</span> Standard
        </button>
      </div>

      <div class="tr__panels">
        <div class="tr__panel">
          <div class="tr__head">
            <label class="tr__label" for="tr-input" data-in-label>Standard English</label>
            <span class="tr__head-spacer" aria-hidden="true"></span>
          </div>
          <textarea id="tr-input" class="tr__area" rows="8" spellcheck="false" placeholder="She has taken the children to see the mice."></textarea>
        </div>

        <div class="tr__swap">
          <button type="button" class="tr__swap-btn" data-swap title="Swap direction and texts" aria-label="Swap direction and texts">
            <span aria-hidden="true">⇄</span>
          </button>
        </div>

        <div class="tr__panel">
          <div class="tr__head">
            <label class="tr__label" for="tr-output" data-out-label>World English</label>
            <button type="button" class="tr__copy" data-copy hidden>Copy</button>
          </div>
          <textarea id="tr-output" class="tr__area" rows="8" readonly spellcheck="false" placeholder="She taked the childs to see the mouses."></textarea>
        </div>
      </div>

      <div class="tr__notes" data-notes>
        <p class="tr__notes-title">Notes</p>
        <ul class="tr__notes-list" data-notes-list></ul>
        <p class="tr__notes-empty" data-notes-empty hidden>
          No flags — every form was converted deterministically.
        </p>
        <p class="tr__notes-hint">
          The translator only applies deterministic changes. These are forms it
          declined to guess — they need part of speech, syntax, or the core
          lexicon to resolve.
        </p>
      </div>

      <p class="tr__status" data-status></p>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector('[data-translate]');
  if (root) {
    const input = root.querySelector('#tr-input');
    const output = root.querySelector('#tr-output');
    const notes = root.querySelector('[data-notes]');
    const notesList = root.querySelector('[data-notes-list]');
    const notesEmpty = root.querySelector('[data-notes-empty]');
    const status = root.querySelector('[data-status]');
    const copyBtn = root.querySelector('[data-copy]');
    const dirBtns = root.querySelectorAll('[data-dir]');
    const swapBtn = root.querySelector('[data-swap]');
    const inLabel = root.querySelector('[data-in-label]');
    const outLabel = root.querySelector('[data-out-label]');

    let direction = 'forward';
    let run = null;
    let timer = null;

    const load = async () => {
      if (run) return run;
      status.textContent = 'Loading…';
      try {
        const [fwd, rev] = await Promise.all([
          import('../../../tools/src/translate.ts'),
          import('../../../tools/src/reverse.ts'),
        ]);
        run = { forward: fwd.translate, reverse: rev.reverseTranslate };
      } catch (e) {
        status.textContent = 'Failed to load translator.';
        console.error(e);
        throw e;
      }
      status.textContent = '';
      return run;
    };

    const doTranslate = async () => {
      const text = input.value;
      if (!text.trim()) {
        output.value = '';
        notesList.innerHTML = '';
        notesEmpty.hidden = true;
        copyBtn.hidden = true;
        return;
      }
      const t = await load();
      if (!t) return;
      const res = direction === 'forward'
        ? t.forward(text, { strict: true })
        : t.reverse(text);
      output.value = res.text;
      copyBtn.hidden = !res.text;

      const flags = res.flags ?? [];
      notesList.innerHTML = '';
      if (flags.length) {
        for (const f of flags) {
          const li = document.createElement('li');
          const target = f.restored ?? f.expected;
          li.textContent = `"${f.found}" → "${target}"  ·  ${f.rule} · ${f.note ?? f.class}`;
          notesList.appendChild(li);
        }
        notesEmpty.hidden = true;
      } else {
        notesEmpty.hidden = false;
      }
    };

    const schedule = () => {
      clearTimeout(timer);
      timer = setTimeout(doTranslate, 250);
    };

    const setDirection = (dir) => {
      if (dir === direction) return;
      direction = dir;
      dirBtns.forEach((b) => {
        const active = b.dataset.dir === dir;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      const isFwd = dir === 'forward';
      inLabel.textContent = isFwd ? 'Standard English' : 'World English';
      outLabel.textContent = isFwd ? 'World English' : 'Standard English';
      input.placeholder = isFwd
        ? 'She has taken the children to see the mice.'
        : 'She taked the childs to see the mouses.';
      output.placeholder = isFwd
        ? 'She taked the childs to see the mouses.'
        : 'She has taken the children to see the mice.';
      schedule();
    };

    input.addEventListener('input', schedule);
    input.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        doTranslate();
      }
    });

    dirBtns.forEach((b) =>
      b.addEventListener('click', () => setDirection(b.dataset.dir)),
    );

    swapBtn.addEventListener('click', () => {
      const swapped = output.value;
      setDirection(direction === 'forward' ? 'reverse' : 'forward');
      input.value = swapped;
      schedule();
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(output.value);
        copyBtn.textContent = 'Copied';
        setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
      } catch {
        output.select();
        document.execCommand('copy');
      }
    });

    load();
  }
</script>

<style>
  .page {
    padding-block: var(--space-8) var(--space-10);
    max-width: 58rem;
    margin-inline: auto;
  }
  .page h1 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-4);
  }

  .tr {
    margin-top: var(--space-6);
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .tr__dir {
    display: inline-flex;
    gap: var(--space-1);
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    padding: 3px;
    margin-bottom: var(--space-4);
  }
  .tr__dir-btn {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .tr__dir-btn.is-active {
    background: var(--surface);
    color: var(--accent);
    box-shadow: var(--shadow-sm);
  }
  .tr__dir-btn:hover:not(.is-active) {
    color: var(--text);
  }

  .tr__panels {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: var(--space-3);
  }
  .tr__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .tr__label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
  }
  .tr__area {
    width: 100%;
    resize: vertical;
    min-height: 10rem;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: var(--leading);
    color: var(--text);
    background: var(--bg);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    box-sizing: border-box;
  }
  .tr__area:focus {
    outline: none;
    border-color: var(--focus);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 30%, transparent);
  }
  .tr__area[readonly] {
    background: var(--accent-soft);
    color: var(--text);
  }

  .tr__swap {
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--space-2);
  }
  .tr__swap-btn {
    appearance: none;
    border: var(--border-w) solid var(--border);
    background: var(--surface);
    color: var(--accent);
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.1rem;
    display: grid;
    place-items: center;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .tr__swap-btn:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .tr__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 1.9rem;
  }
  .tr__head-spacer {
    /* Mirrors the copy button's box so both panel headers have identical
       height and the textareas stay vertically aligned. */
    display: inline-block;
    width: 3.5rem;
    height: 1.6rem;
  }
  .tr__copy {
    appearance: none;
    border: var(--border-w) solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .tr__copy:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .tr__notes {
    margin-top: var(--space-4);
    border-top: var(--border-w) solid var(--border);
    padding-top: var(--space-3);
  }
  .tr__notes-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }
  .tr__notes-list {
    margin: 0 0 var(--space-3);
    padding-left: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
  }
  .tr__notes-hint {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    opacity: 0.85;
  }
  .tr__notes-empty {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
    opacity: 0.85;
  }

  .tr__status {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: var(--space-3) 0 0;
    min-height: 1.2em;
  }

  @media (max-width: 44rem) {
    .tr__panels {
      grid-template-columns: 1fr;
    }
    .tr__swap {
      justify-content: center;
      padding: 0;
    }
  }
</style>
